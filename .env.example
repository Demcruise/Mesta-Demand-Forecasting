# React Bits Pro registry licence (used only by `npx shadcn add @reactbits-pro/<block>`).
# Never commit the real value.
REACTBITS_LICENSE_KEY=

# Identity provider. "demo" runs the built-in simulated SSO flow (no real IdP).
# Replace with an OIDC/SAML provider once the enterprise IdP is confirmed (backlog §93 item 22).
NEXT_PUBLIC_AUTH_MODE=demo
